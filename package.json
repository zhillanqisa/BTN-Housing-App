{
  "name": "pantau-ambles",
  "private": true,
  "version": "0.1.0",
  "description": "PANTAU AMBLES - Cek Tanah Sebelum KPR. Demo web app: peta penurunan tanah per kelurahan, Laporan Ambles, dan Proyeksi Tenor untuk Kota Semarang.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "deploy": "npm run build && node scripts/deploy-pages.mjs",
    "data:boundaries": "node scripts/fetch-boundaries.mjs",
    "data:demo": "node scripts/build-demo-data.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "jspdf": "^4.2.1",
    "maplibre-gl": "^6.18.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "mapshaper": "^0.7.101",
    "osmtogeojson": "^3.0.0-beta.5",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9.3",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  }
}
